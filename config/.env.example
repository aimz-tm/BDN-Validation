# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to config/.env and fill in your values.
# Never commit config/.env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Datalastic AIS & vessel registry API key
# Get one at https://datalastic.com
# Leave blank to run in offline/stub mode (set data_provider.mode: stub in config.yaml)
DATALASTIC_API_KEY=

# Tesseract OCR binary path — required on Windows only.
# Linux/macOS: leave blank if tesseract is on PATH.
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_PATH=

# PostgreSQL connection strings
# Leave blank to run with the in-memory store (no persistence across restarts)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/bdn_db
POSTGRES_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
