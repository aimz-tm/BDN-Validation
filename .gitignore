# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/

# Secrets — never commit these
.env
config/.env
*.pem
*.key

# Database
.postgres-data/
postgres.log

# Editor / tool state
.claude/
.vscode/
.idea/
config/config.yaml.bak
temp_*

# ML model artifacts (generated by scripts/train_model.py)
models_ml/*.pkl

# Runtime uploads — user documents, not source files
static/uploads/

# Release/report artifacts — build outputs, not source
*.zip
*.docx
